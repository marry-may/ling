VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
# The published site: email confirmation links lead here.
VITE_SITE_URL=https://ling.uno/

# Only for `npm run db:migrate` on your computer. Secret: never prefix it with VITE_ and never commit it.
# Supabase → Connect → Connection string → URI → Session pooler.
# SUPABASE_DB_URL=postgresql://postgres.YOUR_PROJECT_ID:YOUR_DB_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres

# Only for `npm run deploy` (upload over SSH with the key ~/.ssh/ling_deploy).
# DEPLOY_SSH=u123456789@HOST
# DEPLOY_SSH_PORT=65002
# DEPLOY_PATH=domains/ling.uno/public_html
