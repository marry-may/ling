# Settings for Apache hosting; other servers ignore this file.

# The PDF reader's worker is an ES module and must be served as JavaScript.
AddType text/javascript .mjs
AddType application/manifest+json .webmanifest

<IfModule mod_headers.c>
  # Files in assets/ have content hashes in their names, so they can be cached for good.
  <FilesMatch "\.(js|mjs|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # The app shell and the service worker must be revalidated, or visitors keep an old version.
  # This block comes last so it overrides the rule above for these files.
  <FilesMatch "^(index\.html|sw\.js|registerSW\.js|workbox-.*\.js|manifest\.webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# Always use HTTPS: the service worker and installing the app require it.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>
